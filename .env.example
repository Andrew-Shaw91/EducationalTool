# CodeSense configuration. Copy to ".env" next to manage.py and edit:
#     cp .env.example .env && chmod 600 .env
# The real .env holds secrets: never commit it or share it.
# Lines starting with # are comments. No spaces around "=".
# With no .env at all the defaults give a working local development setup.

# --- Required on the server -------------------------------------------------
# Turn debug mode OFF on any server. With DEBUG=False the app will not start
# unless SECRET_KEY below is set to a real value.
DEBUG=False

# Generate with (letters, digits, - and _ only, so it is safe in any shell):
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-a-long-random-string

# Comma-separated: your VM's public IP address, plus the domain name later.
ALLOWED_HOSTS=203.0.113.10,localhost,127.0.0.1

# --- Database ---------------------------------------------------------------
# Keep the database OUTSIDE the code folder so updating the code never touches
# research data. The folder must be writable by the service user.
DATABASE_PATH=/srv/codesense/data/db.sqlite3

# --- HTTPS (set up later, when you have a domain name) ----------------------
# Leave False while the site is served over plain http://IP-ADDRESS. Turn on
# only after nginx serves HTTPS, otherwise forms and sessions stop working.
USE_HTTPS=False
# Full origins including https://, only needed with a domain name:
#CSRF_TRUSTED_ORIGINS=https://example.org,https://www.example.org
# Browsers remember "HTTPS only" for this many seconds. Keep 0 at first.
#SECURE_HSTS_SECONDS=0

# --- Logging ------------------------------------------------------------------
# DEBUG, INFO, WARNING or ERROR. Default: INFO when DEBUG=False.
#LOG_LEVEL=INFO

# --- CodeSense options ---------------------------------------------------------
# "keyword" (offline, default) or "ai".
#CODESENSE_FEEDBACK_SERVICE=keyword
# Leave EMPTY: no real LLM adapter is written yet, so a key would have nothing
# to call. The app works fully without one.
CODESENSE_LLM_API_KEY=

# Research data switches (1 = on, 0 = off). See README.md and research/conf.py.
#CODESENSE_ANALYTICS=1
#CODESENSE_STORE_RESPONSE_TEXT=1
#CODESENSE_STORE_HINT_USAGE=1
#CODESENSE_STORE_TIMESTAMPS=1
